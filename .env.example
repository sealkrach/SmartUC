# ---------- Database ----------
POSTGRES_USER=usecasehub
POSTGRES_PASSWORD=usecasehub
POSTGRES_DB=usecasehub
POSTGRES_PORT=5432
# Used when running the backend outside Docker:
DATABASE_URL=postgresql+asyncpg://usecasehub:usecasehub@localhost:5432/usecasehub

# ---------- Security ----------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
# First admin created on startup if no user exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin1234

# ---------- LLM (LiteLLM model strings) ----------
# Examples:
#   anthropic/claude-sonnet-4-5        -> needs ANTHROPIC_API_KEY
#   openai/gpt-4.1-mini                -> needs OPENAI_API_KEY
#   ollama/llama3.1                    -> needs OLLAMA_API_BASE
#   azure/<deployment>                 -> needs AZURE_API_KEY, AZURE_API_BASE, AZURE_API_VERSION
LLM_MODEL=anthropic/claude-sonnet-4-5
LLM_FAST_MODEL=anthropic/claude-haiku-4-5
LLM_TEMPERATURE=0.2

# Embeddings. Use "hash" for a key-less local fallback (lower quality, fine for demos).
#   openai/text-embedding-3-small (1536 dims), voyage/voyage-3-lite (512), ollama/nomic-embed-text (768), hash (384)
EMBEDDING_MODEL=hash
EMBEDDING_DIMS=384

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
VOYAGE_API_KEY=
OLLAMA_API_BASE=http://host.docker.internal:11434

# ---------- Automations ----------
# Cosine similarity above which two use cases become overlap candidates sent to the LLM judge (semantic embeddings)
OVERLAP_CANDIDATE_THRESHOLD=0.55
# Without an LLM judge, pairs above this similarity are flagged as "overlap" for manual review
OVERLAP_FALLBACK_THRESHOLD=0.72
# Same two thresholds when EMBEDDING_MODEL=hash (scores are lower)
HASH_CANDIDATE_THRESHOLD=0.30
HASH_FALLBACK_THRESHOLD=0.37
OVERLAP_MAX_CANDIDATES=8
AUTO_ANALYZE_ON_CHANGE=true

# ---------- Misc ----------
SEED_DEMO_DATA=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_API_URL=/api
BACKEND_PORT=8000
FRONTEND_PORT=3000
